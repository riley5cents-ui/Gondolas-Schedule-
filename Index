const TS=570,TE=1260,PD=1.3,PW=0.52,PM=930;
const toM=t=>{const[h,m]=t.split(':').map(Number);return h*60+m;};
const fmtM=m=>{const h=Math.floor(m/60),mn=m%60,pm=h>=12,dh=h>12?h-12:h===0?12:h;
  return `${dh}${mn?':'+String(mn).padStart(2,'0'):''}${pm?'p':'a'}`;};
const TICKS=[];for(let m=TS;m<=TE;m+=30)TICKS.push(m);
const HTICKS=TICKS.filter(m=>m%60===0);

let state={view:'week',di:0,me:'',week:2};
function W(){return WEEKS[state.week];}
function S(){return W().shifts;}
function D(){return W().days;}

function doLayout(shifts){
  const ss=[...shifts].map(s=>({...s})).sort((a,b)=>toM(a.s)-toM(b.s));
  const ends=[];
  for(const s of ss){
    const sm=toM(s.s);let c=ends.findIndex(e=>e<=sm);
    if(c<0)c=ends.length;s._c=c;ends[c]=toM(s.e);
  }
  const n=ss.length,par=Array.from({length:n},(_,i)=>i);
  const find=i=>{while(par[i]!==i){par[i]=par[par[i]];i=par[i];}return i;};
  const union=(a,b)=>{a=find(a);b=find(b);if(a!==b)par[a]=b;};
  for(let i=0;i<n;i++)for(let j=i+1;j<n;j++)
    if(toM(ss[i].s)<toM(ss[j].e)&&toM(ss[j].s)<toM(ss[i].e))union(i,j);
  const cmax={};
  for(let i=0;i<n;i++){const c=find(i);cmax[c]=Math.max(cmax[c]||0,ss[i]._c);}
  for(let i=0;i<n;i++)ss[i]._n=cmax[find(i)]+1;
  return ss;
}

function el(tag,cls,style){
  const e=document.createElement(tag);
  if(cls)e.className=cls;
  if(style)Object.assign(e.style,style);
  return e;
}

function buildShift(sh,me,loc){
  const isMe=sh.name===me,isOp=!!sh.open;
  const top=(toM(sh.s)-TS)*PD+1;
  const ht=Math.max(18,(toM(sh.e)-toM(sh.s))*PD-2);
  const pct=100/sh._n;
  const cls='shift '+(isMe?'me':isOp?'open':loc);
  const abbrev=sh._n>=4?sh.name.split(' ')[0].slice(0,4):sh._n===3?sh.name.split(' ')[0].slice(0,6):sh.name.split(' ')[0];
  const d=el('div',cls,{position:'absolute',top:top+'px',height:ht+'px',
    left:`${pct*sh._c}%`,width:`calc(${pct}% - 2px)`,zIndex:isMe?'20':'1'});
  const nm=el('div','shift-name');
  nm.textContent=isOp?'Open':isMe?`\u2605 ${abbrev}`:abbrev;
  d.appendChild(nm);
  if(ht>32&&sh.stn){const stn=el('div','shift-stn');stn.textContent=sh.stn;d.appendChild(stn);}
  d.addEventListener('click',e=>{e.stopPropagation();showPopup(sh,d);});
  return d;
}

function buildLocCol(shifts,me,loc){
  const laid=doLayout(shifts);
  const col=el('div','loc-col',{height:(TE-TS)*PD+'px'});
  laid.forEach(sh=>col.appendChild(buildShift(sh,me,loc)));
  return col;
}

function renderDay(){
  const days=D(),shifts=S(),day=days[state.di];
  const all=shifts.filter(s=>s.date===day.k);
  const dtS=all.filter(s=>s.loc==='dt'),sbS=all.filter(s=>s.loc==='sb');
  const AW=42;
  const amDT=dtS.filter(s=>!s.open&&toM(s.s)<PM).length;
  const pmDT=dtS.filter(s=>!s.open&&toM(s.e)>PM).length;
  const amSB=sbS.filter(s=>!s.open&&toM(s.s)<PM).length;
  const pmSB=sbS.filter(s=>!s.open&&toM(s.e)>PM).length;
  const wrap=el('div');

  const strip=el('div','day-strip');
  const back=el('button','back-btn');
  back.innerHTML='<i class="ti ti-arrow-left" style="font-size:12px;margin-right:3px"></i>Week';
  back.onclick=()=>{state.view='week';render();};
  strip.appendChild(back);
  days.forEach((d,i)=>{
    const hasMe=shifts.some(s=>s.date===d.k&&s.name===state.me);
    const btn=el('button','day-btn'+(i===state.di?' active':hasMe?' working':''));
    btn.textContent=d.sh;btn.onclick=()=>{state.di=i;render();};
    strip.appendChild(btn);
  });
  wrap.appendChild(strip);

  const titleDiv=el('div','day-title');
  const h2=el('h2');h2.textContent=day.lg;titleDiv.appendChild(h2);
  wrap.appendChild(titleDiv);

  const hdrs=el('div','col-hdrs');
  hdrs.appendChild(el('div','',{width:AW+'px',flexShrink:'0'}));
  [['dt','ti-map-pin','Downtown'],['sb','ti-droplet','Snack Bar']].forEach(([loc,ico,lbl])=>{
    const h=el('div',`col-hdr ${loc}`);
    h.innerHTML=`<i class="ti ${ico}" style="font-size:12px"></i>${lbl.toUpperCase()}`;
    hdrs.appendChild(h);
  });
  wrap.appendChild(hdrs);

  const grid=el('div','time-grid');
  const ax=el('div','t-axis',{width:AW+'px',height:(TE-TS)*PD+'px'});
  HTICKS.forEach(m=>{const lb=el('div','t-axis-lbl',{top:(m-TS)*PD+'px'});lb.textContent=fmtM(m);ax.appendChild(lb);});
  const pmLb=el('div','t-axis-pm',{top:(PM-TS)*PD+'px'});pmLb.textContent='3:30p';ax.appendChild(pmLb);
  grid.appendChild(ax);
  const content=el('div','t-content');
  HTICKS.forEach(m=>content.appendChild(el('div','t-hrline',{top:(m-TS)*PD+'px'})));
  TICKS.filter(m=>m%60!==0).forEach(m=>content.appendChild(el('div','t-halfline',{top:(m-TS)*PD+'px'})));
  content.appendChild(el('div','t-pmline',{top:(PM-TS)*PD+'px'}));
  content.appendChild(buildLocCol(dtS,state.me,'dt'));
  content.appendChild(buildLocCol(sbS,state.me,'sb'));
  grid.appendChild(content);
  wrap.appendChild(grid);

  const foot=el('div','footer');
  [['dt','DOWNTOWN',amDT,pmDT],['sb','SNACK BAR',amSB,pmSB]].forEach(([loc,lbl,am,pm])=>{
    const cell=el('div','footer-cell');
    const flbl=el('div',`footer-lbl ${loc}`);flbl.textContent=lbl;cell.appendChild(flbl);
    const nums=el('div','footer-nums');
    [['AM',am],['PM',pm]].forEach(([period,n])=>{
      const stat=el('div','footer-num');
      const p=el('div','footer-period');p.textContent=period;stat.appendChild(p);
      const v=el('div','footer-val');v.textContent=String(n);stat.appendChild(v);
      nums.appendChild(stat);
    });
    cell.appendChild(nums);foot.appendChild(cell);
  });
  wrap.appendChild(foot);
  return wrap;
}

