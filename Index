      });
      myS.filter(s=>s.loc===loc).forEach(s=>{
        sub.appendChild(el('div','wk-bar',{top:(toM(s.s)-TS)*PW+'px',
          height:Math.max(2,(toM(s.e)-toM(s.s))*PW)+'px',
          background:'rgba(202,138,4,0.9)',zIndex:'5'}));
      });
      col.appendChild(sub);
    });
    cols.appendChild(col);
  });
  grid.appendChild(cols);
  wrap.appendChild(grid);

  const leg=el('div','week-legend');
  [['rgba(59,130,246,0.55)','Downtown'],['rgba(239,68,68,0.55)','Snack Bar'],
   ...(state.me?[['rgba(202,138,4,0.9)',state.me.split(' ')[0]]]:[])
  ].forEach(([col,lbl])=>{
    const item=el('div','legend-item');
    item.appendChild(el('div','legend-swatch',{background:col}));
    const t=document.createTextNode(lbl);item.appendChild(t);
    leg.appendChild(item);
  });
  wrap.appendChild(leg);
  return wrap;
}

function render(){
  document.getElementById('main').innerHTML='';
  document.getElementById('main').appendChild(state.view==='week'?renderWeek():renderDay());
}

function showPopup(sh,anchor){
  const pop=document.getElementById('shift-popup');
  const isMe=sh.name===state.me, isOp=!!sh.open, loc=sh.loc;
  // fill content
  document.getElementById('sp-name').textContent=isOp?'Open Shift':sh.name;
  document.getElementById('sp-name').className='sp-name '+(isMe?'me':isOp?'open':loc);
  document.getElementById('sp-time-val').textContent=`${fmtM(toM(sh.s))} – ${fmtM(toM(sh.e))}`;
  const stnRow=document.getElementById('sp-stn-row');
  const stnVal=document.getElementById('sp-stn-val');
  if(sh.stn){stnVal.textContent=sh.stn;stnRow.style.display='';}
  else stnRow.style.display='none';
  const badge=document.getElementById('sp-badge');
  badge.className='sp-badge '+(isOp?'open':loc);
  badge.textContent=isOp?'Open':(loc==='dt'?'Downtown':'Snack Bar');
  // position
  pop.style.display='block';
  pop.classList.remove('visible');
  requestAnimationFrame(()=>{
    const r=anchor.getBoundingClientRect();
    const pw=pop.offsetWidth, ph=pop.offsetHeight;
    const vw=window.innerWidth, vh=window.innerHeight;
    let left=r.right+10;
    if(left+pw>vw-8) left=r.left-pw-10;
    if(left<8) left=8;
    let top=r.top;
    if(top+ph>vh-8) top=vh-ph-8;
    if(top<8) top=8;
    pop.style.left=left+'px';
    pop.style.top=top+'px';
    pop.classList.add('visible');
  });
}
function hidePopup(){
  const pop=document.getElementById('shift-popup');
  pop.classList.remove('visible');
  setTimeout(()=>{if(!pop.classList.contains('visible'))pop.style.display='none';},150);
}
document.addEventListener('click',hidePopup);

function setWeek(wi){
  state.week=wi;
  state.view='week';
  state.di=0;
  document.getElementById('week-sub').textContent=W().range;
  document.querySelectorAll('.wtab').forEach((b,i)=>b.classList.toggle('active',i===wi));
  // Rebuild dropdown, keep state.me selected if they work this week
  const prev=state.me;
  const sel=document.getElementById('emp-select');
  sel.innerHTML='<option value="">&#128100; Who are you?</option>';
  const emps=[...new Set(S().filter(x=>!x.open).map(x=>x.name))].sort();
  emps.forEach(n=>{
    const o=document.createElement('option');
    o.value=n;o.textContent=n;
    if(n===prev)o.selected=true;
    sel.appendChild(o);
  });
  // Keep state.me regardless so highlight persists across weeks
  render();
}

// Build calendar-style week tabs
const tabsEl=document.getElementById('week-tabs');
WEEKS.forEach((wk,i)=>{
  const btn=el('button','wtab'+(i===state.week?' active':''));
  const mo=el('div','wtab-month');mo.textContent=wk.month;btn.appendChild(mo);
  const daysRow=el('div','wtab-days');
  wk.calDays.forEach(cd=>{
    const day=el('div','wtab-day');
    const dl=el('div','wtab-dl');dl.textContent=cd.l;day.appendChild(dl);
    const dn=el('div','wtab-dn');dn.textContent=String(cd.n);day.appendChild(dn);
    daysRow.appendChild(day);
  });
  btn.appendChild(daysRow);
  btn.onclick=()=>setWeek(i);
  tabsEl.appendChild(btn);
});

document.getElementById('emp-select').addEventListener('change',e=>{state.me=e.target.value;render();});
setWeek(state.week);

// ── PWA manifest + home screen icon ──────────────────────────────────────
(function(){
  const logoB64='data:image/jpeg;base64,';

  // Apple touch icon
  const atl=document.createElement('link');
  atl.rel='apple-touch-icon';
  atl.href=logoB64;
  document.head.appendChild(atl);

  // Fetch as blob so Chrome Android can use it in manifest
  fetch(logoB64)
    .then(r=>r.blob())
    .then(iconBlob=>{
      const iconUrl=URL.createObjectURL(iconBlob);
      const manifest={
        name:'Gondolas Schedule',
        short_name:'Gondolas',
        start_url:location.href,
        display:'standalone',
        background_color:'#000000',
        theme_color:'#07101e',
        icons:[{src:iconUrl,sizes:'192x192',type:'image/jpeg',purpose:'any maskable'}]
      };
      const ml=document.createElement('link');
      ml.rel='manifest';
      ml.href=URL.createObjectURL(new Blob([JSON.stringify(manifest)],{type:'application/manifest+json'}));
      document.head.appendChild(ml);
    });
})();
</script>
