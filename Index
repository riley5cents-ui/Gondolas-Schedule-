*{box-sizing:border-box;margin:0;padding:0}
body{background:#07101e;color:#dce8f5;font-family:'Outfit',system-ui,sans-serif;min-height:100vh}
::-webkit-scrollbar{width:4px;height:4px;background:transparent}
::-webkit-scrollbar-thumb{background:#1a2e46;border-radius:2px}
#app{max-width:480px;margin:0 auto;padding-bottom:24px}
.app-header{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;
  border-bottom:1px solid #0e1c2e;background:#050e1a;gap:8px;position:sticky;top:0;z-index:100}
.app-header h1{font-size:13px;font-weight:600;color:#c8d8f0;letter-spacing:.3px;display:flex;align-items:center;gap:6px}
.app-header .sub{font-size:10px;color:#1e3a5a;font-family:'JetBrains Mono',monospace;margin-top:1px}
select{background:#0d1929;border:1px solid #1a2e46;color:#7aa8d0;font-size:11px;
  padding:4px 8px;border-radius:6px;cursor:pointer;font-family:'Outfit',sans-serif;max-width:150px;outline:none}
select:focus{border-color:#2a4a6a}
.hint{font-size:10px;color:#1a3050;font-style:italic;text-align:right;padding:4px 14px 2px}

/* ── WEEK TABS (calendar style) ── */
.week-tabs{display:flex;gap:6px;padding:8px 12px;border-bottom:1px solid #0a1828;
  background:#050e1a;position:sticky;top:52px;z-index:95}
.wtab{flex:1;padding:6px 2px 7px;border-radius:8px;border:1px solid #1a2e46;
  background:transparent;cursor:pointer;transition:background .15s,border-color .15s;text-align:center}
.wtab:hover:not(.active){background:#0a1626;border-color:#243c5a}
.wtab.active{background:rgba(59,130,246,0.09);border-color:rgba(59,130,246,0.32)}
.wtab-month{font-size:8.5px;letter-spacing:1.4px;color:#1e3a5a;font-family:'JetBrains Mono',monospace;
  font-weight:600;margin-bottom:5px;text-transform:uppercase}
.wtab.active .wtab-month{color:#3a6a9a}
.wtab-days{display:flex;justify-content:space-evenly;padding:0 2px}
.wtab-day{display:flex;flex-direction:column;align-items:center;gap:3px}
.wtab-dl{font-size:8px;color:#1a3050;font-family:'JetBrains Mono',monospace;line-height:1}
.wtab-dn{font-size:9.5px;font-weight:500;color:#2d4a6a;font-family:'JetBrains Mono',monospace;line-height:1}
.wtab.active .wtab-dl{color:#1e3a5a}
.wtab.active .wtab-dn{color:#60a5fa}

/* ── WEEK VIEW ── */
.week-header{display:flex;border-bottom:1px solid #0a1828}
.week-header .axis-spacer{flex-shrink:0}
.wk-day-hdr{flex:1;text-align:center;padding:5px 0 4px;cursor:pointer;
  border-left:1px solid #0a1828;transition:background .12s}
.wk-day-hdr:hover{background:#0d1929}
.wk-day-hdr.working{background:rgba(202,138,4,0.08)}
.wk-day-hdr .day-name{font-size:11px;font-weight:500;color:#2d4a6a}
.wk-day-hdr.working .day-name{color:#d97706;font-weight:600}
.wk-day-hdr .day-dot{width:4px;height:4px;border-radius:50%;background:#ca8a04;margin:2px auto 0}
.week-grid{display:flex;position:relative}
.wk-axis{flex-shrink:0;position:relative}
.wk-axis-lbl{position:absolute;right:4px;font-size:10px;color:#1a3050;
  font-family:'JetBrains Mono',monospace;transform:translateY(-50%);line-height:1;white-space:nowrap}
.week-cols{flex:1;display:flex;position:relative}
.wk-gridline{position:absolute;left:0;right:0;border-top:1px solid #0a1828;pointer-events:none}
.wk-pmline{position:absolute;left:0;right:0;border-top:1px solid rgba(202,138,4,0.2);pointer-events:none}
.wk-day-col{flex:1;display:flex;cursor:pointer;position:relative;border-left:1px solid #0a1828}
.wk-sub{flex:1;position:relative;overflow:hidden}
.wk-bar{position:absolute;left:0;right:0}
.week-legend{display:flex;justify-content:center;align-items:center;gap:14px;
  padding:8px 0;border-top:1px solid #0a1828}
.legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#2d4a6a}
.legend-swatch{width:10px;height:10px;border-radius:2px;flex-shrink:0}

/* ── DAY VIEW ── */
.day-strip{display:flex;align-items:center;padding:7px 8px;
  border-bottom:1px solid #0a1828;gap:4px;overflow-x:auto;
  background:#050e1a;flex-wrap:nowrap;position:sticky;top:110px;z-index:90}
.day-strip::-webkit-scrollbar{height:0}
.day-btn{cursor:pointer;font-size:11px;padding:3px 9px;border-radius:5px;
  border:1px solid #0e1c2e;background:transparent;color:#2d4a6a;
  font-family:'Outfit',sans-serif;font-weight:400;flex-shrink:0;white-space:nowrap;
  transition:background .12s,color .12s}
.day-btn:hover{background:#0d1929;color:#4a7a9b}
.day-btn.active{background:rgba(202,138,4,0.18);border-color:rgba(202,138,4,0.5);
  color:#d97706;font-weight:600}
.day-btn.working{border-color:rgba(202,138,4,0.3);color:#b45309;opacity:.75}
.back-btn{cursor:pointer;font-size:11px;padding:4px 10px;border-radius:6px;
  border:1px solid #1a2e46;background:transparent;color:#3b82f6;
  font-family:'Outfit',sans-serif;font-weight:500;flex-shrink:0;transition:background .12s}
.back-btn:hover{background:#0d1929}
.day-title{padding:8px 14px 4px}
.day-title h2{font-size:16px;font-weight:600;color:#c8d8f0}
.col-hdrs{display:flex;padding:0 8px 6px;gap:6px}
.col-hdr{flex:1;text-align:center;font-size:11px;font-weight:600;letter-spacing:.7px;
  padding:4px 0;border-radius:4px;display:flex;align-items:center;justify-content:center;gap:4px}
.col-hdr.dt{color:#60a5fa;background:rgba(59,130,246,0.1)}
.col-hdr.sb{color:#f87171;background:rgba(239,68,68,0.1)}
.time-grid{display:flex;position:relative}
.t-axis{flex-shrink:0;position:relative}
.t-axis-lbl{position:absolute;right:5px;font-size:11px;color:#1e3a5a;
  font-family:'JetBrains Mono',monospace;transform:translateY(-50%);line-height:1;white-space:nowrap}
.t-axis-pm{position:absolute;right:4px;font-size:10px;color:rgba(202,138,4,0.7);
  font-family:'JetBrains Mono',monospace;font-weight:600;transform:translateY(-50%);line-height:1}
.t-content{flex:1;position:relative;display:flex;gap:6px;padding-right:6px}
.t-hrline{position:absolute;left:0;right:0;border-top:1px solid #0a1828;pointer-events:none}
.t-halfline{position:absolute;left:0;right:0;border-top:1px dashed rgba(14,28,46,0.7);pointer-events:none}
.t-pmline{position:absolute;left:0;right:0;border-top:1px solid rgba(202,138,4,0.25);pointer-events:none}
.loc-col{flex:1;position:relative}
.shift{position:absolute;border-radius:0 4px 4px 0;padding:2px 5px;overflow:hidden;box-sizing:border-box}
.shift-name{font-size:11px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.shift-stn{font-size:10px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:.7;margin-top:1px}
.shift.dt{background:rgba(59,130,246,0.14);border:.5px solid rgba(59,130,246,0.5);border-left:2.5px solid #3b82f6}
.shift.dt .shift-name{color:#93c5fd}
.shift.dt .shift-stn{color:#60a5fa}
.shift.sb{background:rgba(239,68,68,0.13);border:.5px solid rgba(239,68,68,0.5);border-left:2.5px solid #ef4444}
.shift.sb .shift-name{color:#fca5a5}
.shift.sb .shift-stn{color:#f87171}
.shift.me{background:rgba(202,138,4,0.22);border:.5px solid rgba(202,138,4,0.7);border-left:2.5px solid #ca8a04;z-index:20!important}
.shift.me .shift-name{color:#fbbf24;font-weight:600}
.shift.me .shift-stn{color:#fde68a}
.shift.open{background:rgba(55,65,81,0.15);border:.5px solid rgba(55,65,81,0.4);border-left:2.5px solid #4b5563}
.shift.open .shift-name{color:#6b7280}
.shift.open .shift-stn{color:#6b7280}
.footer{display:flex;border-top:1px solid #0a1828;margin-top:8px;background:#050e1a}
.footer-cell{flex:1;padding:12px 0;text-align:center}
.footer-cell:first-child{border-right:1px solid #0a1828}
.footer-lbl{font-size:11px;font-weight:600;letter-spacing:.5px;margin-bottom:8px}
.footer-lbl.dt{color:#60a5fa}
.footer-lbl.sb{color:#f87171}
.footer-nums{display:flex;justify-content:center;gap:20px}
.footer-num{text-align:center}
.footer-period{font-size:11px;color:#1e3a5a;margin-bottom:2px;font-family:'JetBrains Mono',monospace}
.footer-val{font-size:28px;font-weight:600;color:#c8d8f0;font-family:'JetBrains Mono',monospace;line-height:1.1;font-variant-numeric:tabular-nums}

/* ── SHIFT POPUP ── */
#shift-popup{position:fixed;z-index:300;background:#0c1a2e;border:1px solid #1e3a5a;
  border-radius:10px;padding:11px 14px;min-width:158px;max-width:230px;
  box-shadow:0 6px 24px rgba(0,0,0,0.6);pointer-events:none;
  opacity:0;transition:opacity .14s,transform .14s;transform:scale(0.95);display:none}
#shift-popup.visible{opacity:1;transform:scale(1);pointer-events:auto}
.sp-name{font-size:13px;font-weight:600;margin-bottom:6px;line-height:1.3}
.sp-name.dt{color:#93c5fd}
.sp-name.sb{color:#fca5a5}
.sp-name.me{color:#fbbf24}
.sp-name.open{color:#9ca3af}
.sp-row{display:flex;align-items:center;gap:6px;margin-top:4px}
.sp-icon{font-size:11px;color:#1e3a5a;flex-shrink:0;width:14px;text-align:center}
.sp-text{font-size:11px;color:#4a7a9b;font-family:'JetBrains Mono',monospace;line-height:1.3}
.sp-stn{font-size:11px;color:#2d5a7a;font-style:italic;line-height:1.3}
.sp-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;
  letter-spacing:.5px;padding:2px 7px;border-radius:4px;margin-top:6px}
.sp-badge.dt{color:#60a5fa;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.2)}
.sp-badge.sb{color:#f87171;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.18)}
.sp-badge.open{color:#6b7280;background:rgba(75,85,99,0.12);border:1px solid rgba(75,85,99,0.2)}
</style>
</head>
